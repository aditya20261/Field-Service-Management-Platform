*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:#f5f7fb;color:#18212f}.auth{min-height:100vh;display:grid;place-items:center;padding:24px;background:linear-gradient(135deg,#eef3ff,#f9fafc)}.card{width:420px;background:white;border:1px solid #e5e9f0;border-radius:18px;padding:38px;box-shadow:0 18px 50px #18212f12}.brand{font-weight:800;letter-spacing:2px;font-size:22px}.card h1{margin:34px 0 8px;font-size:30px}.muted{color:#697586;margin-bottom:28px}.card form{display:grid;gap:14px}.card input{height:48px;border:1px solid #d7dce5;border-radius:10px;padding:0 14px;font-size:15px}.card button,header button{height:46px;border:0;border-radius:10px;background:#18212f;color:#fff;font-weight:700;cursor:pointer}.link{background:transparent!important;color:#18212f!important;margin-top:12px;width:100%}.error{color:#c62828}.dashboard{min-height:100vh}.dashboard header{height:72px;background:#fff;border-bottom:1px solid #e5e9f0;display:flex;align-items:center;justify-content:space-between;padding:0 6%}.dashboard header button{padding:0 20px}.hero{padding:55px 6% 30px}.hero h1{font-size:38px;margin:12px 0}.hero p{color:#697586}.role{display:inline-block;background:#eaf0ff;padding:7px 12px;border-radius:20px;font-size:12px;font-weight:800}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;padding:20px 6%}.tile{background:#fff;border:1px solid #e5e9f0;border-radius:15px;padding:24px;min-height:120px}.tile b,.tile span{display:block}.tile span{margin-top:10px;color:#697586;font-size:14px}
