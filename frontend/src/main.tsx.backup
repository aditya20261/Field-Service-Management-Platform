        </div>
      </div>

      <section className="panel">
        <div className="table-wrap">
          <table>
            <thead>
              <tr>
                <th>
                  Work Order
                </th>

                <th>
                  Title
                </th>

                <th>
                  Site
                </th>

                <th>
                  Technician
                </th>

                <th>
                  Status
                </th>

                <th></th>
              </tr>
